# Variables públicas del frontend para builds de producción, es decir, todo lo
# que pasa por `expo export`: `npm run build:web` (Vercel) y las builds nativas.
# Expo incrusta estos valores en el bundle: aquí NUNCA va nada secreto
# (solo variables EXPO_PUBLIC_*).
#
# En desarrollo (`npm start`) este archivo no se carga: la URL del backend se
# deduce sola (ver frontend/config/api.ts).
#
# Una variable ya definida en el entorno tiene prioridad sobre este archivo.
# Para construir contra otro backend:
#   EXPO_PUBLIC_API_URL=http://localhost:5005/api npm run build:web
EXPO_PUBLIC_API_URL=https://gymstatus.onrender.com/api
