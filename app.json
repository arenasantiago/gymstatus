{
  "expo": {
    "name": "Athlete Performance",
    "slug": "gymstatus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/pwa/icon.png",
    "primaryColor": "#2563EB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pwa/adaptive-foreground.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "favicon": "./assets/pwa/favicon.png",
      "name": "Athlete Performance",
      "shortName": "Atletas",
      "themeColor": "#2563EB",
      "backgroundColor": "#0A0F1A",
      "display": "standalone",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-sharing"
    ]
  }
}
