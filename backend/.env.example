# Copia este archivo como `.env` y rellena los valores.
# NO subas el archivo .env real al repositorio.

# Cadena de conexión de MongoDB (local o MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/gymstatus

# Puerto del servidor
PORT=5000

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
