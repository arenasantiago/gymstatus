# Copia este archivo como `.env` y rellena los valores.
# NO subas el archivo .env real al repositorio.

# Cadena de conexión de MongoDB (local o MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/gymstatus

# Puerto del servidor
PORT=5005

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes web permitidos por CORS en producción, separados por comas.
# Añade aquí el dominio del frontend en Vercel (sin barra final). En Render
# ya viene definido en render.yaml.
# En desarrollo los localhost de Expo/Metro ya están permitidos.
# CORS_ORIGINS=https://gymstatus-frontend.vercel.app

# Duración de la sesión (formato de jsonwebtoken: 12h, 7d...). Por defecto 12h.
# JWT_EXPIRES_IN=12h

# Pon "off" si tu red resuelve bien los registros SRV de mongodb+srv://
# DNS_OVERRIDE=off
